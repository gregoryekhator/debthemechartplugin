<footer id="page-footer" class="deb-footer-sync text-white" style="display: block !important; background: transparent !important;">
    <div class="footer-content-wrapper" style="background: #007bff; border-radius: 0 0 20px 20px; margin: 0 3rem 3rem 3rem; padding-bottom: 20px;">
        {{! Social Bar }}
        <div class="d-flex justify-content-between align-items-center px-4 py-3" style="border-bottom: 1px solid rgba(255,255,255,0.2);">
            <span class="deb-footer-sync text-white">Get connected with us on social networks:</span>
            <div class="social-icons">
                <i class="fa fa-facebook mr-3"></i><i class="fa fa-twitter mr-3"></i>
            </div>
        </div>

        {{! Main Content }}
        <div class="container-fluid p-5">
            <div class="row">
                <div class="col-md-7">
                <h3 class="font-weight-bold mb-4">{{brandorganization_footer}}</h3>
                <p class="font-weight-regular mb-4">Debonair Training Systems provides advanced neural-mapped analytics to optimize human capital development and cognitive retention.</p>
            </div>
                <div class="col-md-5 pl-md-5">
                    <h5 class="font-weight-bold mb-4">Contact</h5>
                    <p class="font-weight-bold mb-4"><i class="fa fa-globe mr-3"></i> {{custom_footer_data.contact_web}}</p>
                    <p class="mb-2"><i class="fa fa-envelope mr-3"></i> {{custom_footer_data.contact_email}}</p>
                    <p class="mb-2"><i class="fa fa-phone mr-3"></i> {{custom_footer_data.contact_phone}}</p>
                </div>
            </div>
        </div>

        <div class="text-center py-3" style="background: rgba(0,0,0,0.1);">
            <p class="m-0 small">{{custom_footer_data.copyright}}</p>
        </div>
    </div>
</footer>