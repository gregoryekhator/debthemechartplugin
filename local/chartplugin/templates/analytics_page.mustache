<div class="chartplugin-content mx-5">
    <div class="alert bg-white shadow-sm d-flex justify-content-between align-items-center my-4 p-3" 
         style="border-left: 6px solid #ff002d; border-radius: 15px;">
        <div class="h6 mb-0 font-weight-bold text-dark">
            <i class="fa fa-robot mr-2 text-primary"></i>AI Dashboard Performance Status
        </div>
        {{#has_access}}
            <button onclick="triggerRecoveryTools()" class="btn btn-success px-4 rounded-pill font-weight-bold shadow-sm">Engage Recovery Plan</button>
        {{/has_access}}
        {{^has_access}}
            <a href="recovery.php" class="btn btn-success px-4 rounded-pill font-weight-bold shadow-sm">Engage Recovery Plan</a>
        {{/has_access}}
    </div>

    <div class="card p-4 shadow-sm border-0 mb-4" style="border-radius: 25px;">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h3 class="font-weight-bold mb-0">{{chart_title}}</h3>
                <p class="small text-muted mb-0"><i class="fa fa-magic mr-1"></i> {{chart_tooltip}}</p>
            </div>
            <div class="btn-group">
                <a href="?type={{current_type}}&format=bar" class="btn btn-sm btn-outline-primary {{#is_bar}}active{{/is_bar}}">Bar</a>
                <a href="?type={{current_type}}&format=line" class="btn btn-sm btn-outline-primary {{#is_line}}active{{/is_line}}">Line</a>
                <a href="?type={{current_type}}&format=pie" class="btn btn-sm btn-outline-primary {{#is_pie}}active{{/is_pie}}">Pie</a>
            </div>
        </div>
        <div style="min-height: 350px;">{{{main_chart_html}}}</div>
    </div>

    <div class="row mb-5">
        <div class="col-md-4">
            <div class="bg-white p-3 shadow-sm border cockpit-card" style="border-radius: 20px; height: 420px; overflow: hidden;">
                <p class="small font-weight-bold text-muted">LAST VIEW: {{#last_viewed}}{{title}}{{/last_viewed}}{{^last_viewed}}None{{/last_viewed}}</p>
                {{{last_viewed.html}}}
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white p-3 shadow-sm border cockpit-card" style="border-radius: 20px; height: 420px; overflow: hidden;">
                <p class="small font-weight-bold text-muted">PREVIOUS VIEW: {{#prev_viewed}}{{title}}{{/prev_viewed}}{{^prev_viewed}}None{{/prev_viewed}}</p>
                {{{prev_viewed.html}}}
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white p-3 shadow-sm border cockpit-card" style="border-radius: 20px; height: 420px; display: flex; flex-direction: column;">
                <p class="small font-weight-bold text-center text-muted">AI PREDICTIVE MINER</p>
                <div id="ai-chat-box" style="background:#0d1117; color:#00ff41; flex-grow:1; border-radius:12px; padding:15px; font-family:monospace; overflow-y: auto;">
                    {{#has_access}}> Neural Engine Ready...<br>> System active.{{/has_access}}
                    {{^has_access}}<div class="text-center mt-5 text-white"><i class="fa fa-lock fa-3x mb-3"></i><br>Insights Locked</div>{{/has_access}}
                </div>
                {{#has_access}}
                <div class="input-group mt-2">
                    <input type="text" id="ai-user-q" class="form-control" placeholder="Ask AI...">
                    <button class="btn btn-primary" onclick="triggerAI()">Query</button>
                </div>
                {{/has_access}}
            </div>
        </div>
    </div>

    <div class="cta-container text-center p-5 mb-5 bg-light" style="border-radius: 30px; border: 2px dashed #007bff;">
        <h4 class="font-weight-bold">Need a Specialized Deep Dive?</h4>
        <button class="btn btn-primary rounded-pill px-5 mt-2 shadow">Contact Us</button>
    </div>
</div>

<script>
function triggerAI() {
    const input = document.getElementById('ai-user-q');
    const box = document.getElementById('ai-chat-box');
    if (!input || !box || input.value.trim() === "") return;
    const q = input.value; input.value = "";
    box.innerHTML += `<div class="mt-2 small text-info text-right"><em>${q}</em></div>`;
    setTimeout(() => {
        let resp = "{{#is_trial}}Trial insights enabled. Your velocity is 12% above cohort.{{/is_trial}}{{#is_enterprise}}Enterprise status active. High-fidelity mapping in progress.{{/is_enterprise}}";
        box.innerHTML += `<div class="mt-2 ai-response"><strong>AI Analyst:</strong> ${resp}</div>`;
        box.scrollTop = box.scrollHeight;
    }, 1000);
}

function triggerRecoveryTools() {
    const box = document.getElementById('ai-chat-box');
    box.innerHTML += `<div class="mt-3 p-2 bg-success text-white small" style="border-radius: 5px;"><strong>Protocol:</strong> Recovery plan engaged. Analyzing proficiency gaps...</div>`;
    box.scrollTop = box.scrollHeight;
}
</script>
