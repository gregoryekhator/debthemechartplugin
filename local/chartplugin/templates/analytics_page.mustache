<div id="deb-dashboard-container" class="container-fluid">
    <div class="alert deb-ai-hero p-3 mb-4 d-flex align-items-center">
        <div class="mr-3"><i class="fa fa-robot fa-2x text-danger"></i></div>
        <div>
            <strong>AI Insights:</strong> {{ai_hero_text}}
        </div>
    </div>

    <div class="row deb-main-content-row">
        <div class="deb-chart-col">
            <div class="card deb-chart-card shadow-sm mb-4">
                <div class="card-body">
                    <h4 class="card-title">{{chart_title}}</h4>
                    <p class="card-subtitle mb-3 text-muted">{{chart_subtitle}}</p>
                    <div class="chart-wrapper">
                        {{{main_chart}}}
                    </div>
                </div>
            </div>
        </div>

        <div class="deb-sidebar-col">
            <h5 class="mb-3">Learning History</h5>
            {{#history_blocks}}
            <div class="card deb-sidebar-card shadow-sm mb-3">
                <div class="card-body p-3">
                    <h6 class="font-weight-bold text-primary">{{title}}</h6>
                    <p class="small text-muted">{{subtitle}}</p>
                    <div class="sidebar-chart-mini">
                        {{{content}}}
                    </div>
                </div>
            </div>
            {{/history_blocks}}
            
            {{^history_blocks}}
            <div class="text-center p-4 border rounded bg-light">
                <p class="small text-muted">No history data available yet.</p>
            </div>
            {{/history_blocks}}
        </div>
    </div>
</div>