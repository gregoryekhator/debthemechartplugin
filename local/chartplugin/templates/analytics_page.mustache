<div class="flight-deck-container">
    <style>
        /* CSS Force for Titles */
        .chart-area text[text-anchor="middle"] { font-size: 2em !important; font-weight: bold !important; fill: #333 !important; }
        
        /* Grid Alignment */
        .btn-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; width: 100%; }
        @media (max-width: 991px) { .btn-grid { grid-template-columns: repeat(2, 1fr); } }

        .flight-deck-main-grid { display: flex; flex-wrap: wrap; margin: 0 -15px; width: 100%; }
        .main-content-area { flex: 0 0 75%; max-width: 75%; padding: 0 15px; }
        .sidebar-content-area { flex: 0 0 25%; max-width: 25%; padding: 0 15px; }

        @media (max-width: 1024px) { 
            .main-content-area, .sidebar-content-area { flex: 0 0 100%; max-width: 100%; }
        }

        /* Highlight Force */
        .active-btn { background-color: #212529 !important; color: white !important; border: 2px solid #fff !important; box-shadow: 0 4px 8px rgba(0,0,0,0.3) !important; }
    </style>

    <div class="card mb-4 border-0 shadow-sm" style="background: #007bff; color: white; border-radius: 15px;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0 font-weight-bold">Debonair Training AI Dashboard</h3>
                <div class="license-badges">
                    <span class="badge badge-pill badge-light text-primary py-2 px-3 mr-1" style="opacity: 0.8;">Freemium</span>
                    <span class="badge badge-pill badge-light text-primary py-2 px-3 mr-1">Premium Mode</span>
                    <span class="badge badge-pill badge-warning py-2 px-3 font-weight-bold">Enterprise Mode</span>
                </div>
            </div>
            <div class="btn-grid">
                {{#buttons}}
                <a href="{{{url}}}" class="btn btn-sm {{#active}}active-btn{{/active}}{{^active}}btn-light{{/active}} shadow-sm">{{label}}</a>
                {{/buttons}}
            </div>
        </div>
    </div>

    <div class="alert alert-white border-left border-danger shadow-sm d-flex justify-content-between align-items-center mb-4 bg-white">
        <span class="text-danger font-weight-bold">{{ai_hero_text}}</span>
        <button class="btn btn-success font-weight-bold shadow-sm">Engage Recovery Plan</button>
    </div>

    <div class="flight-deck-main-grid">
        <div class="main-content-area">
            <div class="card shadow-sm border-0 p-3 h-100 chart-area" style="min-height: 550px;">
                <div class="d-flex justify-content-end mb-2">
                    <div class="btn-group btn-group-sm">
                        <a href="{{{bar_url}}}" class="btn btn-outline-secondary {{#is_bar}}active{{/is_bar}}">Bar</a>
                        <a href="{{{line_url}}}" class="btn btn-outline-secondary {{#is_line}}active{{/is_line}}">Line</a>
                        <a href="{{{pie_url}}}" class="btn btn-outline-secondary {{#is_pie}}active{{/is_pie}}">Pie</a>
                    </div>
                </div>
                {{{main_chart}}}
            </div>
        </div>
        
        <div class="sidebar-content-area">
            {{#history_blocks}}
            <div class="card shadow-sm border-0 p-2 mb-3" style="min-height: 250px;">
                <h6 class="text-dark text-center small font-weight-bold mb-1">{{title}}</h6>
                <p class="text-muted text-center mb-1" style="font-size: 0.7rem;">{{description}}</p>
                <div style="height: 180px; width: 100%;">{{{content}}}</div>
            </div>
            {{/history_blocks}}
        </div>
    </div>

    <footer class="mt-4 p-4 text-white shadow-lg" style="background: #007bff; border-radius: 15px;">
        <div class="container-fluid">
            <div class="row align-items-start">
                <div class="col-md-7 border-right border-white-50">
                    <h4 class="font-weight-bold">Debonair Training Ltd</h4>
                    <p class="small pr-4">Our mission is to harness digital learning technology and 21st century pedagogical strategies to deliver measurable excellence.</p>
                    <p class="small mb-0">© 2002 – 2026 Debonair Training Ltd</p>
                </div>
                <div class="col-md-5 pl-md-5">
                    <div class="d-flex mb-3">
                        <a href="#" class="text-white mr-3"><i class="fa fa-facebook-square fa-lg"></i></a>
                        <a href="#" class="text-white mr-3"><i class="fa fa-twitter-square fa-lg"></i></a>
                        <a href="#" class="text-white mr-3"><i class="fa fa-linkedin-square fa-lg"></i></a>
                    </div>
                    <h6 class="font-weight-bold text-uppercase mb-2">Contact</h6>
                    <ul class="list-unstyled small">
                        <li><i class="fa fa-globe mr-2"></i> www.debonairtraining.com</li>
                        <li><i class="fa fa-envelope mr-2"></i> info@debonairtraining.com</li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>
</div>