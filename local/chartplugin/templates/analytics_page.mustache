<div id="deb-dashboard-container" class="container-fluid p-4" style="background-color: #f8f9fc; min-height: 100vh; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

    {{! --- TRUE BLUE HEADER --- }}
    <div class="card mb-4 border-0 shadow-sm" style="background: #007bff; color: white; border-radius: 15px;">
        <div class="card-body p-4">
            <h2 class="text-white mb-4" style="font-weight: 700;">Debonair Training AI Dashboard</h2>
            <div class="row no-gutters">
                {{#buttons}}
                <div class="col-6 col-md-3 p-1">
                    <a href="{{{url}}}" 
                       class="btn btn-block {{#active_class}}deb-active-now{{/active_class}}{{^active_class}}btn-light{{/active_class}}" 
                       style="height: 45px; display: flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 0.85rem; font-weight: 600; border: none; white-space: nowrap;">
                        {{label}}
                    </a>
                </div>
                {{/buttons}}
            </div>
        </div>
    </div>

    {{! --- AI HERO BAR --- }}
    <div class="alert alert-white border-left border-danger shadow-sm d-flex justify-content-between align-items-center mb-4 bg-white px-4 py-3" style="border-left-width: 6px !important; border-radius: 10px;">
        <div class="d-flex align-items-center">
            <i class="fa fa-robot fa-2x text-danger mr-3"></i>
            <span class="text-danger font-weight-bold" style="font-size: 1.1rem;">{{ai_hero_text}}</span>
        </div>
        
        <div class="recovery-action-zone">
            {{#is_active_plan}}
                <span class="badge badge-success px-4 py-2" style="border-radius: 20px; font-size: 0.9rem;">Plan Active</span>
            {{/is_active_plan}}
            {{^is_active_plan}}
                <a href="{{{recovery_url}}}" class="btn btn-success font-weight-bold px-4 py-2 shadow-sm" style="border-radius: 25px; background-color: #28a745; border: none;">
                    Engage Recovery Plan
                </a>
            {{/is_active_plan}}
        </div>
    </div>

    {{! --- MAIN GRID --- }}
    <div class="row">
        <div class="col-lg-9 col-md-12">
            <div class="card p-4 shadow-sm border-0 mb-4" style="border-radius: 15px;">
                <h3 class="mb-3" style="font-weight: 700;">{{current_chart_label}}</h3>
                <div class="main-chart-viewport" style="position: relative; min-height: 400px; width: 100%;">
                    {{{main_chart}}}
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-12">
            {{#history_blocks}}
                <div class="card mb-3 shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                    <div class="card-body p-3">
                        <h6 class="text-muted small mb-2" style="text-transform: uppercase; letter-spacing: 1px;">{{title}}</h6>
                        <div class="sidebar-chart-viewport" style="height: 180px; width: 100%; position: relative;">
                            {{{content}}}
                        </div>
                    </div>
                </div>
            {{/history_blocks}}
        </div>
    </div>

    {{! --- TRUE BLUE FOOTER WITH SOCIAL BAR --- }}
    <footer class="mt-5 shadow-lg" style="background: #007bff; border-radius: 15px; overflow: hidden; color: white;">
        {{! SOCIAL NETWORKS BAR (IMAGE 3 MATCH) }}
        <div class="d-flex justify-content-between align-items-center px-5 py-3" style="border-bottom: 1px solid rgba(255,255,255,0.2);">
            <span style="font-weight: 500; opacity: 0.9;">Get connected with us on social networks:</span>
            <div class="social-icons">
                <i class="fab fa-facebook-f mx-2"></i>
                <i class="fab fa-twitter mx-2"></i>
                <i class="fab fa-google-plus-g mx-2"></i>
                <i class="fab fa-linkedin-in mx-2"></i>
                <i class="fab fa-instagram mx-2"></i>
                <i class="fab fa-youtube mx-2"></i>
                <i class="fa fa-bookmark mx-2"></i>
            </div>
        </div>

        {{! MAIN FOOTER CONTENT }}
        <div class="p-5">
            <div class="row">
                <div class="col-md-8">
                    <h3 class="font-weight-bold mb-3">Debonair Training Ltd</h3>
                    <p style="font-size: 1.05rem; line-height: 1.6; opacity: 0.95;">
                        Our mission is to harness digital learning technology and 21st century pedagogical strategies to implement our clients' digital business plan for desired results. To tenaciously increase their market share as a result of measurable excellence.
                    </p>
                </div>
                <div class="col-md-4">
                    <h5 class="font-weight-bold mb-3 text-uppercase">Contact</h5>
                    <p class="mb-1 small"><i class="fa fa-globe mr-2"></i>www.debonairtraining.com</p>
                    <p class="mb-1 small"><i class="fa fa-envelope mr-2"></i>info@debonairtraining.com</p>
                    <p class="mb-1 small"><i class="fa fa-phone mr-2"></i>+234 80 2228 8685 OR +44 7828 151901</p>
                </div>
            </div>
            <div class="text-center mt-4 pt-4" style="border-top: 1px solid rgba(255,255,255,0.2);">
                <p class="small mb-0">© 2002 - 2026 Copyright: Debonair Training Ltd</p>
            </div>
        </div>
    </footer>
</div>

<style>
    .deb-active-now { background-color: #002d5a !important; color: white !important; border: 1px solid white !important; }
    .sidebar-chart-viewport canvas { height: 180px !important; width: 100% !important; }
    .main-chart-viewport canvas { min-height: 400px !important; width: 100% !important; }
    .social-icons i { cursor: pointer; transition: opacity 0.2s; }
    .social-icons i:hover { opacity: 0.7; }
</style>