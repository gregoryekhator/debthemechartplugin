{{! /var/www/html/moodle_test/local/chartplugin/templates/analytics_page.mustache }}
<div class="gold-v3-container">
    <style>
        .cockpit-header { background: #007bff; padding: 1.5rem; border-radius: 8px 8px 0 0; color: white; position: relative; }
        /* The "Image 8" Flex Fix */
        .nav-flex-container { 
            display: flex; 
            flex-wrap: wrap; 
            gap: 10px; 
            margin-top: 20px; 
            justify-content: space-between;
        }
        .nav-flex-container a { 
            flex: 1 1 calc(25% - 10px); /* Forces 4 per row, but wraps perfectly to a second row */
            min-width: 150px;
            text-align: center;
        }
        .ai-alert-box { border-left: 5px solid #dc3545; background: #fff; padding: 1.2rem; margin-top: -1px; border-top: 1px solid #eee; }
        .sidebar-scaler { transform: scale(0.65); transform-origin: 0 0; width: 153%; height: 153%; }
    </style>

    <div class="cockpit-header shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="h3 mb-0 text-white">Debonair Learning Flight Deck</h2>
            <span class="badge badge-warning p-2">Enterprise Mode</span>
        </div>
        
        <div class="nav-flex-container">
            {{#buttons}}
            <a href="{{{url}}}" class="btn btn-sm {{#active}}btn-dark{{/active}}{{^active}}btn-light text-primary{{/active}} shadow-sm border-0">
                {{label}}
            </a>
            {{/buttons}}
        </div>
    </div>

    <div class="ai-alert-box shadow-sm mb-4 d-flex justify-content-between align-items-center">
        <div>
            <p class="h5 mb-1 font-weight-bold text-danger">{{ai_hero_text}}</p>
            <div class="custom-control custom-switch">
                <input type="checkbox" class="custom-control-input" id="aiToggle" checked>
                <label class="custom-control-label small text-muted" for="aiToggle">AI Insight Active</label>
            </div>
        </div>
        <a href="#" class="btn btn-success btn-lg px-4">Engage Recovery Plan</a>
    </div>

    <div class="row">
        <div class="col-md-9">
            <div class="bg-white p-4 shadow-sm rounded border">
                <div class="main-chart-render" style="height: 450px;">{{{main_chart}}}</div>
            </div>
        </div>
        <div class="col-md-3">
            {{#history_blocks}}
            <div class="card mb-3 p-2 shadow-sm border-0 bg-light">
                <small class="text-uppercase text-muted font-weight-bold">{{title}}</small>
                <div class="sidebar-scaler" style="height: 200px;">{{{content}}}</div>
            </div>
            {{/history_blocks}}
        </div>
    </div>
</div>