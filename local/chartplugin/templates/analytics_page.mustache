<div id="deb-dashboard-container" class="container-fluid p-4" style="background-color: #f8f9fc; min-height: 100vh; font-family: 'Segoe UI', Roboto, sans-serif;">

    {{! --- HEADER --- }}
    <div class="card mb-4 border-0 shadow-sm" style="background: #007bff; color: white; border-radius: 15px;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-white m-0" style="font-weight: 700; font-size: 2.1rem;">Debonair Training AI Dashboard</h2>
                <span class="badge badge-warning px-4 py-2" style="border-radius: 20px; font-size: 1.1rem; color: #000;">{{user_level}} LEVEL</span>
            </div>
            <div class="row no-gutters">
                {{#buttons}}
                <div class="col-6 col-md-3 p-1">
                    <a href="{{{url}}}" class="btn btn-block {{#active_class}}deb-active-now{{/active_class}}{{^active_class}}btn-light{{/active_class}}" 
                       style="height: 50px; display: flex; align-items: center; justify-content: center; border-radius: 8px; font-size: 1.1rem; font-weight: 600; border: none;">{{label}}</a>
                </div>
                {{/buttons}}
            </div>
        </div>
    </div>

    {{! --- AI HERO --- }}
    <div class="alert alert-white border-left border-danger shadow-sm d-flex justify-content-between align-items-center mb-4 bg-white px-4 py-3" style="border-left-width: 6px !important; border-radius: 10px;">
        <div class="d-flex align-items-center">
            <i class="fa fa-robot fa-2x text-danger mr-3"></i>
            <span class="text-danger font-weight-bold" style="font-size: 1.2rem;">{{ai_hero_text}}</span>
        </div>
        <div>
            {{#is_active_plan}}<span class="badge badge-success px-4 py-2" style="border-radius: 20px; font-size: 1rem;">Plan Active</span>{{/is_active_plan}}
            {{^is_active_plan}}<a href="{{{recovery_url}}}" class="btn btn-success font-weight-bold px-4 py-2" style="border-radius: 25px; font-size: 1rem;">Engage Recovery Plan</a>{{/is_active_plan}}
        </div>
    </div>

    {{! --- CENTERED TITLES --- }}
    <div class="text-center mb-4 px-5">
        <h3 style="font-size: 21.3px; font-weight: 700; color: #1a1a1a; margin-bottom: 8px;">{{chart_title}}</h3>
        <p style="font-size: 18.6px; font-weight: 400; color: #6c757d; line-height: 1.4;">{{chart_subtitle}}</p>
    </div>

    {{! --- MAIN GRID --- }}
    <div class="row">
        <div class="col-lg-9 col-md-12">
            <div class="card p-4 shadow-sm border-0 mb-4" style="border-radius: 15px; min-height: 500px; position: relative;">
                <div class="btn-group btn-group-sm mb-3" style="position: absolute; right: 20px; top: 20px; z-index: 10;">
                    <a href="?type={{current_type}}&render=bar" class="btn {{#is_bar}}btn-dark{{/is_bar}}{{^is_bar}}btn-outline-dark{{/is_bar}}">Bar</a>
                    <a href="?type={{current_type}}&render=line" class="btn {{#is_line}}btn-dark{{/is_line}}{{^is_line}}btn-outline-dark{{/is_line}}">Line</a>
                    <a href="?type={{current_type}}&render=pie" class="btn {{#is_pie}}btn-dark{{/is_pie}}{{^is_pie}}btn-outline-dark{{/is_pie}}">Pie</a>
                </div>
                {{{main_chart}}}
            </div>
        </div>

        <div class="col-lg-3 col-md-12">
            {{#history_blocks}}
            <div class="card mb-3 shadow-sm border-0" style="border-radius: 12px; background: white; overflow: hidden;">
                <div class="card-body p-3">
                    <h6 class="text-dark mb-1" style="font-size: 1.1rem; font-weight: 700;">{{title}}</h6>
                    <p class="text-muted mb-2" style="font-size: 13px; line-height: 1.2;">{{subtitle}}</p>
                    <div class="sidebar-canvas-lock" style="height: 160px; width: 100%;">{{{content}}}</div>
                </div>
            </div>
            {{/history_blocks}}
        </div>
    </div>

    {{! --- BRANDED FOOTER --- }}
    <footer class="mt-5 shadow-lg" style="background: #007bff; border-radius: 15px; overflow: hidden; color: white;">
        <div class="d-flex justify-content-between align-items-center px-5 py-3" style="border-bottom: 1px solid rgba(255,255,255,0.15);">
            <span style="font-size: 1.05rem;">Get connected with us on social networks:</span>
            <div class="social-icons" style="font-size: 1.2rem;">
                <i class="fab fa-facebook-f mx-2"></i><i class="fab fa-twitter mx-2"></i>
                <i class="fab fa-google-plus-g mx-2"></i><i class="fab fa-linkedin-in mx-2"></i>
                <i class="fab fa-instagram mx-2"></i><i class="fas fa-globe mx-2"></i><i class="fas fa-bookmark mx-2"></i>
            </div>
        </div>
        <div class="row p-5">
            <div class="col-md-7">
                <h3 class="font-weight-bold mb-3" style="font-size: 1.8rem;">Debonair Training Ltd</h3>
                <p style="font-size: 1.1rem; line-height: 1.7; opacity: 0.9;">
                    Our mission is to harness digital learning technology and 21st century pedagogical strategies to implement our clients' digital business plan for desired results. To tenaciously increase their market share as a result of measurable excellence.
                </p>
            </div>
            <div class="col-md-5 pl-md-5">
                <h5 class="text-uppercase font-weight-bold mb-4" style="letter-spacing: 1px;">Contact</h5>
                <ul class="list-unstyled" style="font-size: 1.05rem; line-height: 2;">
                    <li><i class="fas fa-globe mr-3"></i> www.debonairtraining.com</li>
                    <li><i class="fas fa-envelope mr-3"></i> info@debonairtraining.com</li>
                    <li><i class="fas fa-phone mr-3"></i> +234 80 2228 8685 OR +44 7828 151901</li>
                </ul>
            </div>
        </div>
    </footer>
</div>

<style>
    .deb-active-now { background-color: #002d5a !important; color: white !important; border: 2px solid white !important; }
    .sidebar-canvas-lock canvas { max-width: 100% !important; width: 100% !important; height: 160px !important; }
    .social-icons i { cursor: pointer; transition: opacity 0.2s; }
    .social-icons i:hover { opacity: 0.7; }
</style>