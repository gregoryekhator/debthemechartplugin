<div id="deb-dashboard-container" class="container-fluid p-4" style="background-color: #f8f9fc; min-height: 100vh;">

    {{! --- TOP NAV --- }}
    <div class="card mb-4 border-0 shadow-sm" style="background: #007bff; color: white; border-radius: 15px;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-white m-0" style="font-weight: 700;">Debonair Training AI Dashboard</h2>
                <span class="badge badge-warning px-3 py-2" style="border-radius: 15px; color: #000;">{{user_level}}</span>
            </div>
            <div class="row no-gutters">
                {{#buttons}}
                <div class="col-6 col-md-3 p-1">
                    <a href="{{{url}}}" 
                       class="btn btn-block {{#active_class}}deb-active-now{{/active_class}}{{^active_class}}btn-light{{/active_class}} {{#locked}}deb-locked-btn{{/locked}}" 
                       {{#locked}}data-toggle="modal" data-target="#upgradeModal"{{/locked}}
                       style="border-radius: 8px; font-weight: 600; border: none; height: 45px; display: flex; align-items: center; justify-content: center;">
                        {{#locked}}<i class="fa fa-lock mr-2" style="font-size: 0.8rem;"></i>{{/locked}}
                        {{label}}
                    </a>
                </div>
                {{/buttons}}
            </div>
        </div>
    </div>

    {{! --- AI INSIGHT --- }}
    <div class="alert bg-white shadow-sm d-flex justify-content-between align-items-center mb-4 px-4 py-3" style="border-left: 6px solid #dc3545; border-radius: 10px;">
        <div class="d-flex align-items-center">
            <i class="fa fa-robot fa-2x text-danger mr-3"></i>
            <span class="text-danger font-weight-bold">{{ai_hero_text}}</span>
        </div>
        <button class="btn {{#is_freemium}}btn-outline-danger{{/is_freemium}}{{^is_freemium}}btn-success{{/is_freemium}} btn-sm font-weight-bold px-4" style="border-radius: 20px;">
            {{#is_freemium}}Engage Recovery Plan{{/is_freemium}}{{^is_freemium}}Plan Active{{/is_freemium}}
        </button>
    </div>

    {{! --- DASHBOARD GRID --- }}
    <div class="row no-gutters">
        {{! LEFT: Main Chart }}
        <div class="col-lg-8 pr-lg-4" style="margin-left: -15px;">
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 15px; overflow: hidden; background: white;">
                <div class="p-4 text-center">
                    <h4 class="font-weight-bold mb-1">{{chart_title}}</h4>
                    <p class="text-muted small">{{chart_subtitle}}</p>
                </div>
                <div class="main-chart-container" style="height: 450px;">
                    {{{main_chart}}}
                </div>
            </div>
        </div>

        {{! RIGHT: Sidebar (Y-Axis Fixed) }}
        <div class="col-lg-4">
            <h6 class="mb-3 font-weight-bold text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 1px;">Recent Insights</h6>
            {{#history_blocks}}
            <div class="card mb-3 shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="card-body p-3">
                    <p class="font-weight-bold text-dark mb-1" style="font-size: 0.85rem;">{{title}}</p>
                    <div class="sidebar-chart-safe-zone" style="height: 180px;">
                        {{{content}}}
                    </div>
                </div>
            </div>
            {{/history_blocks}}
        </div>
    </div>

    {{! --- FOOTER --- }}
    <div class="mt-5 shadow-sm" style="border-radius: 20px; overflow: hidden; background: #007bff; color: white;">
        <footer class="p-5">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h4 class="font-weight-bold">Debonair Training Ltd</h4>
                    <p class="mb-0 opacity-75">Harnessing digital learning technology for measurable excellence.</p>
                </div>
                <div class="col-md-4 text-md-right mt-3 mt-md-0">
                    <p class="small mb-0">© 2002 - 2026 Debonair Training Ltd.</p>
                </div>
            </div>
        </footer>
    </div>
</div>

<style>
    .deb-active-now { background-color: #002d5a !important; color: white !important; border: 1px solid white !important; }
    .deb-locked-btn { background-color: #e9ecef !important; color: #adb5bd !important; cursor: not-allowed; }

    /* 1. Flush Left for main chart */
    .main-chart-container canvas {
        margin-left: -15px !important;
        width: calc(100% + 15px) !important;
    }

    /* 2. SIDEBAR FIX: Adding internal padding so numbers are visible */
    .sidebar-chart-safe-zone {
        padding-left: 10px;
    }
    .sidebar-chart-safe-zone canvas {
        width: 100% !important;
        height: 100% !important;
    }

    /* 3. Relocate Data link to bottom-right */
    .chart-table-expand {
        display: block !important;
        text-align: right !important;
        padding-right: 15px;
        margin-top: -10px;
        font-size: 0.7rem;
        color: #007bff;
    }
</style>