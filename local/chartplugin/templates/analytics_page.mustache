<div class="flight-deck-container">
    <style>
        /* Restoring the width constraints that fixed the overlap */
        .flight-deck-main-grid { display: flex; flex-wrap: wrap; margin-right: -15px; margin-left: -15px; }
        .main-content-area { flex: 0 0 75%; max-width: 75%; padding: 0 15px; }
        .sidebar-content-area { flex: 0 0 25%; max-width: 25%; padding: 0 15px; }
        
        /* Fixes for the overlapping sidebar charts seen in image_6aa089.png */
        .sidebar-card { background: #fff; border-radius: 8px; padding: 10px; margin-bottom: 15px; border: 1px solid #eee; overflow: hidden; }
        .sidebar-chart-wrapper { height: 180px; width: 100%; position: relative; }
        
        /* Header Button Styling to match image_7579f3.png */
        .btn-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
        .enterprise-badge { background: #ffc107; color: #000; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: bold; }
    </style>

    <div class="card mb-4 border-0 shadow-sm" style="background: #007bff; color: white;">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Debonair Learning Flight Deck</h4>
                <span class="enterprise-badge">Enterprise Mode</span>
            </div>
            <div class="btn-grid">
                {{#buttons}}
                <a href="{{{url}}}" class="btn btn-sm {{#active}}btn-dark{{/active}}{{^active}}btn-light{{/active}} shadow-sm">
                    {{label}}
                </a>
                {{/buttons}}
            </div>
        </div>
    </div>

    <div class="alert alert-white border-left border-danger shadow-sm d-flex justify-content-between align-items-center mb-4">
        <span class="text-danger font-weight-bold">{{ai_hero_text}}</span>
        <a href="{{{recovery_url}}}" class="btn btn-success font-weight-bold shadow-sm">Engage Recovery Plan</a>
    </div>

    <div class="flight-deck-main-grid">
        <div class="main-content-area">
            <div class="card shadow-sm border-0 p-3">
                <div class="main-chart-render">
                    {{{main_chart}}}
                </div>
            </div>
        </div>

        <div class="sidebar-content-area">
            {{#history_blocks}}
            <div class="sidebar-card shadow-sm">
                <h6 class="text-muted text-center small font-weight-bold uppercase">{{title}}</h6>
                <div class="sidebar-chart-wrapper">
                    {{{content}}}
                </div>
            </div>
            {{/history_blocks}}
        </div>
    </div>
</div>