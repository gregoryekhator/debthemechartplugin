<div class="mx-5 p-4 bg-white border-left border-right shadow-sm">
    {{! AI Hero Section }}
    <div class="alert alert-white border-left border-danger shadow-sm d-flex justify-content-between align-items-center mb-4 px-4 py-3" style="border-left-width: 6px !important; border-radius: 10px;">
        <div class="d-flex align-items-center">
            <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center mr-3" style="width: 40px; height: 40px;">
                <i class="fa fa-bolt"></i>
            </div>
            <div>
                <div class="small text-muted font-weight-bold">AI PERFORMANCE INSIGHT</div>
                <div class="font-weight-bold text-dark">{{{ai_hero_text}}}</div>
            </div>
        </div>
        <a href="   recovery.php" class="btn btn-success btn-sm font-weight-bold px-4" style="border-radius: 20px;">ENGAGE RECOVERY PLAN</a>
    </div>

    {{! Main Chart with Toggle & Subtitles }}
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-end mb-3">
            <div>
                <h3 class="m-0 font-weight-bold text-dark">{{chart_title}}</h3>
                <p class="text-danger m-0 font-weight-bold" style="font-size: 0.9rem;"><i class="fa fa-magic mr-1"></i> {{chart_ai_subtitle}}</p>
            </div>
            <div class="btn-group">
                <a href="?type={{current_type}}&format=bar" class="btn btn-outline-secondary btn-sm {{#is_bar}}active{{/is_bar}}">Bar</a>
                <a href="?type={{current_type}}&format=line" class="btn btn-outline-secondary btn-sm {{#is_line}}active{{/is_line}}">Line</a>
                <a href="?type={{current_type}}&format=pie" class="btn btn-outline-secondary btn-sm {{#is_pie}}active{{/is_pie}}">Pie</a>
            </div>
        </div>
        <div class="p-3 border rounded bg-light">{{{main_chart}}}</div>
    </div>

    {{! Comparison Row: 3 Boxes (Last View, Previous View, AI Predictive) }}
    <div class="row">
        {{#history_blocks}}
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm bg-white" style="border-radius: 12px; border-top: 4px solid #007bff !important;">
                <div class="card-body p-3">
                    <h6 class="font-weight-bold text-primary mb-1" style="font-size: 0.8rem;">{{title}}</h6>
                    <p class="small text-muted mb-2" style="font-size: 0.7rem; line-height: 1.2;">{{subtitle}}</p>
                    <div style="transform: scale(0.9); transform-origin: top left;">{{{content}}}</div>
                </div>
            </div>
        </div>
        {{/history_blocks}}
        
        
            <div class="terminal-container p-3 shadow bg-dark" style="border-radius: 20px; height: 400px; display: flex; flex-direction: column;">
                <div class="terminal-header text-center small text-success border-bottom border-secondary pb-2 mb-2">AI PREDICTIVE MINER</div>
                <div id="ai-log" class="flex-grow-1 overflow-auto p-2 text-success" style="font-family: monospace; font-size: 0.9rem;">
                    > System standby... Ready for input.
                </div>
            </div>
        
    </div>
<div class="cta-container text-center p-5 mb-5 bg-light" style="border-radius: 30px; border: 2px dashed #007bff;">
        <h4 class="font-weight-bold">Need a Specialized Deep Dive?</h4>
        <button class="btn btn-primary rounded-pill px-5 mt-2 shadow">Contact Us</button>
    </div>
</div>

<script>
function triggerAI() {
    const input = document.getElementById('ai-user-q');
    const box = document.getElementById('ai-chat-box');
    if (!input || !box || input.value.trim() === "") return;
    const q = input.value; input.value = "";
    box.innerHTML += `<div class="mt-2 small text-info text-right"><em>${q}</em></div>`;
    setTimeout(() => {
        let resp = "{{#is_trial}}Trial insights enabled. Your velocity is 12% above cohort.{{/is_trial}}{{#is_enterprise}}Enterprise status active. High-fidelity mapping in progress.{{/is_enterprise}}";
        box.innerHTML += `<div class="mt-2 ai-response"><strong>AI Analyst:</strong> ${resp}</div>`;
        box.scrollTop = box.scrollHeight;
    }, 1000);
}

function triggerRecoveryTools() {
    const box = document.getElementById('ai-chat-box');
    box.innerHTML += `<div class="mt-3 p-2 bg-success text-white small" style="border-radius: 5px;"><strong>Protocol:</strong> Recovery plan engaged. Analyzing proficiency gaps...</div>`;
    box.scrollTop = box.scrollHeight;
}
</script>