<div id="deb-dashboard-container" class="container-fluid p-0" style="background-color: #f4f7f6; min-height: 100vh; overflow-x: hidden;">

    {{! --- TOP BLUE BLOCK --- }}
    <div class="shadow-sm" style="background: #007bff; color: white; border-radius: 25px; margin: 20px; padding: 30px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="font-weight-bold m-0">Debonair Training AI Dashboard</h2>
            <button class="btn btn-warning font-weight-bold text-dark px-4" data-toggle="modal" data-target="#subscriptionModal" style="border-radius: 20px;">
                {{user_level}} LEVEL
            </button>
        </div>

        {{! 4x2 GRID }}
        <div class="row no-gutters">
            {{#buttons}}
            <div class="col-md-3 p-1">
                <a href="{{{url}}}" class="btn btn-block py-2 shadow-sm {{active_class}}" 
                   style="background: white; color: #007bff; border-radius: 10px; font-weight: 600; border: none; transition: 0.3s;">
                    {{label}}
                </a>
            </div>
            {{/buttons}}
        </div>
    </div>

    <div class="mx-4">
        {{! AI HERO BAR }}
        <div class="alert alert-white border-left border-danger shadow-sm d-flex justify-content-between align-items-center mb-4 bg-white p-3" style="border-left-width: 6px !important; border-radius: 15px;">
            <div class="d-flex align-items-center">
                <i class="fa fa-robot fa-2x text-danger mr-3"></i>
                <span class="text-danger font-weight-bold">{{ai_hero_text}}</span>
            </div>
            <button class="btn btn-success btn-sm rounded-pill px-4" data-toggle="modal" data-target="#subscriptionModal">Plan Active</button>
        </div>

        <div class="row no-gutters">
            {{! MAIN CHART }}
            <div class="col-lg-9 pr-lg-3">
                <div class="card p-4 shadow-sm border-0 mb-4" style="border-radius: 20px;">
                    <div style="position: absolute; top: 20px; right: 20px; z-index: 10;">
                        <div class="btn-group border bg-white shadow-sm" style="border-radius: 8px; overflow: hidden;">
                            <a href="?type={{current_type}}&render=bar" class="btn btn-sm {{#is_bar}}btn-dark text-white{{/is_bar}}{{^is_bar}}btn-light{{/is_bar}}">Bar</a>
                            <a href="?type={{current_type}}&render=line" class="btn btn-sm {{#is_line}}btn-dark text-white{{/is_line}}{{^is_line}}btn-light{{/is_line}}">Line</a>
                            <a href="?type={{current_type}}&render=pie" class="btn btn-sm {{#is_pie}}btn-dark text-white{{/is_pie}}{{^is_pie}}btn-light{{/is_pie}}">Pie</a>
                        </div>
                    </div>
                    <div class="text-center mb-4">
                        <h4 class="font-weight-bold">{{chart_title}}</h4>
                        <p class="text-muted small">ML Analysis: {{chart_subtitle}}</p>
                    </div>
                    <div class="chart-container" style="position: relative; height: 450px;">
                        {{{main_chart}}}
                    </div>
                </div>
            </div>

            {{! SIDEBAR }}
            <div class="col-lg-3">
                <h6 class="text-muted font-weight-bold small mb-3">RECENT INSIGHTS</h6>
                {{#history_blocks}}
                <div class="card mb-3 shadow-sm border-0" style="border-radius: 15px;">
                    <div class="card-body p-3 text-center">
                        <h6 class="font-weight-bold small mb-1">{{title}}</h6>
                        <p class="text-muted" style="font-size: 0.65rem;">{{subtitle}}</p>
                        <div style="height: 140px;">{{{content}}}</div>
                    </div>
                </div>
                {{/history_blocks}}
            </div>
        </div>
    </div>

    {{! --- BOTTOM BLUE FOOTER --- }}
    <footer class="shadow-lg" style="background: #007bff; color: white; border-radius: 25px; margin: 20px; overflow: hidden;">
        <div class="d-flex justify-content-between align-items-center px-5 py-3" style="background: rgba(0,0,0,0.1);">
            <span class="small">Get connected with us on social networks:</span>
            <div class="social-icons">
                <i class="fab fa-facebook-f mx-2"></i><i class="fab fa-twitter mx-2"></i><i class="fab fa-linkedin-in mx-2"></i><i class="fas fa-globe mx-2"></i>
            </div>
        </div>
        <div class="p-5 row align-items-center no-gutters">
            <div class="col-md-8">
                <h3 class="font-weight-bold">Debonair Training Ltd</h3>
                <p class="opacity-75">Our mission is to harness digital learning technology and 21st century pedagogical strategies.</p>
            </div>
            <div class="col-md-4 text-md-right">
                <p class="mb-0">info@debonairtraining.com</p>
                <p>+44 7828 151901</p>
            </div>
        </div>
    </footer>

    {{! --- SUBSCRIPTION MODAL --- }}
    <div class="modal fade" id="subscriptionModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content text-center border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-body p-5">
                    <i class="fa fa-gem fa-4x text-primary mb-4"></i>
                    <h3 class="font-weight-bold">Upgrade to Premium</h3>
                    <p class="text-muted">Unlock advanced ML-driven predictive forecasting and personalized competency maps.</p>
                    <div class="my-4">
                        <h2 class="font-weight-bold">$19.99<small class="text-muted">/mo</small></h2>
                    </div>
                    <button class="btn btn-primary btn-block btn-lg mb-3" style="border-radius: 10px;">Upgrade Now</button>
                    <button class="btn btn-link text-muted" data-dismiss="modal">Maybe later</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .deb-active-now { background-color: #002d5a !important; color: white !important; transform: scale(1.05); border: 2px solid white !important; }
    .chart-container canvas { max-width: 100% !important; height: 100% !important; }
</style>