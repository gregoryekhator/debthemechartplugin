<script>
function triggerAI() {
    const input = document.getElementById('ai-user-q');
    const box = document.getElementById('ai-chat-box');
    if (!input || !box || input.value.trim() === "") return;
    
    const q = input.value;
    input.value = "";
    
    // User bubble (Navy Blue)
    box.innerHTML += `<div class="mb-3 text-right"><div class="d-inline-block p-2 rounded text-white shadow-sm" style="background: #001f3f; max-width: 85%; border-radius: 15px 15px 0px 15px !important;">${q}</div></div>`;
    
    // AI Analyst response (Friendly Student-Centric Voice)
    setTimeout(() => {
        box.innerHTML += `
            <div class="mb-3">
                <div class="d-inline-block p-3 rounded shadow-sm bg-white text-dark" style="max-width: 85%; border-radius: 15px 15px 15px 0px !important; border-left: 4px solid #28a745;">
                    <strong>AI Analyst:</strong> Looking at the **{{chart_title}}** data, you're on a great path! If you spend an extra 15 minutes on the areas where the chart dips, you'll likely see a 10-15 point boost in your next assessment. Should I list those topics for you?
                </div>
            </div>`;
        box.scrollTop = box.scrollHeight;
    }, 750);
}
</script>